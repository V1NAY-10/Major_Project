# LLM (any OpenAI-compatible endpoint with tool calling)
GROQ_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Cerebras (free tier, much higher tokens/minute than Groq free):
#   LLM_BASE_URL=https://api.cerebras.ai/v1   LLM_MODEL=gpt-oss-120b
# Google Gemini (free tier):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash

# Token budget knobs (lower them for small free-tier limits)
# MODEL_SUMMARY_CHARS=4500
# LLM_INPUT_TOKEN_BUDGET=5500
# LLM_REASONING_EFFORT=low
# LLM_HISTORY_MESSAGES=8
# TOOL_RESULT_CHARS=4000

# Optional MongoDB for sessions/chat history (in-memory if unset)
MONGODB_URI=
MONGODB_DB_NAME=freecad_ai

# Auth: Clerk secret key (same as frontend/.env.local) to verify session tokens.
CLERK_SECRET_KEY=
# AUTH_DISABLED=1   # local testing only: skip token verification

# Let the agent run arbitrary Python inside FreeCAD (run_freecad_python). Off by default.
# AGENT_ALLOW_PYTHON=1

# FreeCAD bridge: gui | headless | off
FREECAD_AUTOSTART=gui
# FREECAD_GUI_EXE=C:/Program Files/FreeCAD 1.0/bin/freecad.exe
# FREECAD_CMD_EXE=C:/Program Files/FreeCAD 1.0/bin/freecadcmd.exe
